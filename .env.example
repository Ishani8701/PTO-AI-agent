# Copy to .env and fill in your values. Never commit .env.

# Azure OpenAI — chat model (needed to run the shell)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Embedding model — you'll need this once you start on RAG (coursework Part 2).
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ServiceNow — live PTO API integration (coursework Part 3).
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-integration-username
SERVICENOW_PASSWORD=your-integration-password

# Google Calendar — read-only access to each employee's own calendar (see
# tools/calendar_client.py, scripts/authorize_calendar.py). client_id/secret
# come from a "Desktop app" type OAuth client you create in Google Cloud
# Console — that type, not "Web application", is what InstalledAppFlow
# expects (it handles the local redirect itself, no fixed port/path to
# pre-register).
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.readonly
